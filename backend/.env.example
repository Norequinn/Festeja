# Base de datos PostgreSQL (Supabase Session Pooler URL)
# Ejemplo: postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres?sslmode=require"

# Secreto para firmar tokens JWT (en producción usa una cadena larga y aleatoria)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto HTTP (Render asigna PORT automáticamente)
PORT=4000

# Desactivar modo demo/pruebas en producción (false en producción, true en local)
ENABLE_DEMO_MODE=false

# Supabase Storage (para guardar fotos de perfil, wishlist, chat y soportes de pago)
SUPABASE_URL="https://TU_PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="TU_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="festeja-uploads"
